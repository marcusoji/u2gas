# U2GAS frontend — production build values for Cloudflare Pages.
#
# Copy to `.env.production` (git-ignored) and fill in the real values:
#
#   cp web/.env.production.example web/.env.production
#
# The copied frontend (web/) reads NONE of these yet: it is a carbon copy of the
# uploaded U2gas_frontend-main.zip and renders data.ts fixtures. They are the
# contract for wiring it to the Worker; set them when that step is done.
#
# Public values only. Every NEXT_PUBLIC_ variable is compiled into the browser
# bundle — never put a Supabase secret/service-role key here.

# Worker origin + /api, e.g. https://api.u2gas.ng/api
NEXT_PUBLIC_API_BASE=https://api.YOUR-DOMAIN/api
# Worker origin, no path. Used for the CSP and media fallbacks.
NEXT_PUBLIC_API_ORIGIN=https://api.YOUR-DOMAIN
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase -> Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# NEVER the secret key. Everything NEXT_PUBLIC_ is compiled into the bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy name for the same public key; only needed to keep an older deployment
# working. Leave unset on anything new.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_MEDIA_BASE=https://YOUR-PROJECT-REF.supabase.co/storage/v1/object/public/public-media
