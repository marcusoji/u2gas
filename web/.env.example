# Public values only. Anything secret belongs in Worker secrets, never here —
# every NEXT_PUBLIC_ variable is compiled into the browser bundle.

# Local preview: serve the whole UI from in-browser fixtures, with no Supabase
# project and no Worker. Set to "true" and the values below become unused —
# including NEXT_PUBLIC_API_ORIGIN, which such a build does not need for the CSP.
NEXT_PUBLIC_EMBEDDED_API=false

NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787/api
# Worker origin, no path. Used for the CSP and media fallbacks.
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8787
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase -> Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# NEVER put the secret key here. Everything NEXT_PUBLIC_ is compiled into the bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy name for the same public key; only needed to keep an older deployment
# working. Leave unset on anything new.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_MEDIA_BASE=https://your-project.supabase.co/storage/v1/object/public/public-media
