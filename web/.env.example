# Public values only. Anything secret belongs in Worker secrets, never here —
# every VITE_ variable is compiled into the browser bundle.

# Local preview: serve the whole UI from in-browser fixtures, with no Supabase
# project and no Worker. Set to "true" and the values below become unused —
# including VITE_API_ORIGIN, which such a build does not need for the CSP.
VITE_EMBEDDED_API=false

VITE_API_BASE=http://127.0.0.1:8787/api
# Worker origin, no path. Written into the CSP in dist/_headers at build time;
# the production build fails if it is missing or still a placeholder. Only a
# VITE_EMBEDDED_API=true build may leave it unset.
VITE_API_ORIGIN=http://127.0.0.1:8787
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase -> Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# NEVER put the secret key here. Everything VITE_ is compiled into the bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy name for the same public key; only needed to keep an older deployment
# working. Leave unset on anything new.
# VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
VITE_MEDIA_BASE=https://your-project.supabase.co/storage/v1/object/public/public-media
