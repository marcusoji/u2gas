# Loaded only by `vite dev` (development mode). NOT by `vite build`, which is
# production and reads `.env` instead — so this file cannot leak into a build.
#
# It makes `npm run dev` run the whole UI with no backend at all: no Supabase
# project, no Worker, no sign-in. Every screen is reachable from in-browser
# fixtures, and identity is chosen with `?as=<role>` (customer | staff |
# driver | admin) or the bottom-right role switch.
#
# Do not set the API/Supabase variables here. Anything VITE_ is compiled into
# the bundle, and an embedded build never reads them — see web/.env.example for
# the real-API values.
VITE_EMBEDDED_API=true
