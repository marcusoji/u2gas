# Cloudflare Pages headers for the U2GAS UI.
#
# Generated by scripts/build-headers.mjs — do not edit out/_headers by hand.
# The API-origin placeholder below is replaced with the Worker origin the app
# was built with.
#
# A guest checkout returns a `guest_token` that travels in the URL (`?t=…`).
# A referrer would leak it to every third party a receipt links to, so
# Referrer-Policy is `no-referrer` globally. `connect-src` names the Worker
# origin explicitly: there is no wildcard, and a build with no origin is
# refused rather than shipping a hole.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {{API_ORIGIN}} https://*.supabase.co; font-src 'self' data:; connect-src 'self' {{API_ORIGIN}} https://*.supabase.co; frame-src 'self' https://*.monnify.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=()
  X-Frame-Options: DENY

# Content-hashed build assets never change under their name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The pixel and LED faces are content-stable too.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# A receipt page carries a guest token in its query, so it must not be stored
# by an intermediary or left in a shared cache.
/orders/*
  Cache-Control: no-store
