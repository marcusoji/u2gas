{
  "name": "u2gas-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-assets.mjs && tsc -b && vite build && node scripts/build-headers.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lighthouse": "lhci autorun",
    "check:assets": "node scripts/check-assets.mjs",
    "check:figma-registry": "node scripts/check-figma-registry.mjs",
    "check:frontend": "node scripts/check-assets.mjs && node scripts/check-figma-registry.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zxing-wasm": "^1.2.11"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
